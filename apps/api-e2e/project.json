{
  "name": "api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["api", "seeder"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/api-e2e"],
      "dependsOn": ["api:build", "seeder:build", "api:serve-e2e"],
      "cache": false,
      "options": {
        "command": "vitest run --config=apps/api-e2e/vite.config.ts --passWithNoTests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc -p apps/api-e2e/tsconfig.spec.json --noEmit"]
      }
    }
  }
}

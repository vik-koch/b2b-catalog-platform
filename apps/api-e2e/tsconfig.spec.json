{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    // ts-jest must transpile the ESM-only JS dependencies listed in
    // transformIgnorePatterns, not just our TypeScript.
    "allowJs": true,
    "types": ["jest", "node"]
  },
  "include": ["jest.config.ts", "src/**/*.ts"]
}

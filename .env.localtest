# Env for the local smoke test of the deploy stack (incl. compose.override.yml):
#   docker compose --env-file .env.localtest up -d

STACK_NAME=localtest

APP_DOMAIN=localhost

API_IMAGE=b2b-catalog-platform-api:localtest
WEB_IMAGE=b2b-catalog-platform-web:localtest

POSTGRES_DB=b2b_catalog
POSTGRES_USER=b2b_catalog
POSTGRES_PASSWORD=localtest

# Signs the session JWT (min 32 chars). Smoke-test-only value.
JWT_SECRET=localtest-insecure-jwt-secret-0123456789abcdef

# Bootstrap admin created by the bootstrap-admin one-shot on `up`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=localtest-admin-password
# A seeded stack: its admin keeps the deploy's password rather than being asked
# to change it, as on a demo stack. The forced flow has its own throwaway
# account and spec (change-password.spec.ts).
ADMIN_FORCE_PASSWORD_CHANGE=false

# Filesystem root the API writes uploaded editor/catalog images to. Required by
# the API in server mode. A mounted volume in deployed stacks; a local directory
# for dev (created on first upload).
MEDIA_ROOT=./.media
# Host port the dev media nginx (compose.db.yml) publishes; the web dev-server
# proxy forwards /media here so uploads are viewable under `nx serve`.
MEDIA_PORT=8027

# Login rate limit, per IP per minute. Lifted far above the deployment default
# (10) because the Playwright suite signs in dozens of times from one address
# inside a single window, and would otherwise throttle its own run.
AUTH_RATE_LIMIT=1000
# Same reason, for the inquiry and registration forms.
PUBLIC_FORM_RATE_LIMIT=1000

# Host port for the published Postgres (see compose.override.yml)
DATABASE_PORT=5433

# Mail goes to the Mailpit sink service (compose.override.yml), reached on the
# stack-internal network.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=Coffee Kontor <no-reply@coffee-kontor.example>
MAIL_STAFF_TO=hallo@coffee-kontor.example
MAIL_ADMIN_TO=admin@coffee-kontor.example

# --- Per-deployment config ---
# The test fixture, which the e2e suites assert. compose mounts it at /config
# and sets CONFIG_PATH=/config itself.
CONFIG_DIR=./deployments/fixture/config
# The blocklist path must still be set here, not left to compose's
# ${VAR:-/config/...} default: Nx loads the workspace .env (relative dev paths)
# into process.env, and a real env var beats both --env-file and the default in
# compose interpolation — so without it the relative dev value would leak into
# the container and the file would not be found.
PASSWORD_BLOCKLIST_FILE=/config/password-blocklist.txt

# No address suggestions: the dev .env names a suggestion sidecar, and Nx would
# carry it into this stack the same way, so whether checkout asks for the street
# alone would depend on who started the run. Empty matches CI.
SUGGESTION_SIDECAR_URL=

{
  "branding": {
    "name": "Coffee Kontor",
    "title": "Coffee Kontor — wholesale specialty coffee",
    "startYear": 2021,
    "theme": {
      "primary": "#6f4e37",
      "secondary": "#8b6f52",
      "accent": "#b45309"
    }
  },
  "pages": {
    "published": ["about", "conditions", "privacy", "imprint", "contact"],
    "headerNav": ["about", "contact"],
    "footerNav": ["conditions", "privacy", "imprint", "licenses"]
  },
  "cookieConsentEnabled": false,
  "catalog": {
    "currency": {
      "code": "EUR",
      "locale": "de-DE"
    },
    "boxUnits": {
      "volume": "m³",
      "weight": "kg"
    }
  },
  "locations": [
    {
      "name": "Speicherstadt Office",
      "description": "Am Sandtorkai 30, 20457 Hamburg",
      "map": {
        "url": "https://www.openstreetmap.org/export/embed.html?bbox=9.9820%2C53.5400%2C9.9950%2C53.5460&layer=mapnik&marker=53.5430%2C9.9880"
      }
    }
  ],
  "contact": {
    "phone": "+49 40 1234567",
    "email": "hallo@coffee-kontor.example"
  },
  "phoneInput": {
    "countryCode": "+49",
    "mask": "(###) ###-####"
  },
  "address": {
    "countries": [
      {
        "code": "DE",
        "label": "Germany"
      }
    ]
  },
  "companyIdInput": {
    "formats": [
      {
        "key": "vat",
        "label": "VAT number",
        "pattern": "^DE[0-9]{9}$",
        "prefix": "DE",
        "mask": "#########",
        "example": "DE123456789"
      },
      {
        "key": "tax",
        "label": "Tax number",
        "pattern": "^[0-9]{10}$",
        "mask": "##########",
        "example": "1234567890"
      }
    ]
  }
}

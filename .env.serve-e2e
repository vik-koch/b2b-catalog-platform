# The api-e2e run's own stack. Nx loads this file for `api:serve-e2e` ahead of
# `.env`, so these values win for the API the suite runs against; the api-e2e
# vitest config loads it too, for the specs and the global setup. Everything
# not set here is the dev stack's `.env`.
#
# No ${VAR} references: the vitest config parses this file without expansion.

# Off the dev API's 3000, so a running `nx serve api` is never hit or killed.
API_PORT=3100

# compose.api-e2e.yml — its own Postgres and Mailpit, not the dev ones
# (5432 / 1025 / 8025) or web-e2e's localtest (5433 / 8026).
POSTGRES_DB=b2b_catalog_e2e
POSTGRES_USER=postgres
POSTGRES_PASSWORD=api-e2e
DATABASE_PORT=5435
DATABASE_URL=postgresql://postgres:api-e2e@localhost:5435/b2b_catalog_e2e
MAIL_PORT=1026
MAILPIT_UI_PORT=8028

# Uploads go here, not into the dev stack's ./.media.
MEDIA_ROOT=./.media-e2e

# The suite asserts *which* mails a move produces, by reading them out of
# Mailpit straight after the response. Mail normally leaves the request behind
# (MailDispatcher), so that read would be a race; `inline` puts the send back
# inside the request for these runs only. No deployment sets this.
MAIL_DELIVERY=inline

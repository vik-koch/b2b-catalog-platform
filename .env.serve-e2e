# Loaded by Nx for `api:serve-e2e` only — the API the api-e2e suite runs
# against. Everything else about that server is the dev stack's `.env`.
#
# The suite asserts *which* mails a move produces, by reading them out of
# Mailpit straight after the response. Mail normally leaves the request behind
# (MailDispatcher), so that read would be a race; `inline` puts the send back
# inside the request for these runs only. No deployment sets this.
MAIL_DELIVERY=inline

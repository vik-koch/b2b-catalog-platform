# Template for a VPS stack's .env (lives next to compose.yml on the VM).

# Stack identifier — unique per stack on the VM (dev | prod).
# Used for the Traefik router names.
STACK_NAME=dev

# Public hostname of this stack — Traefik host rule + Let's Encrypt cert
APP_DOMAIN=b2b-dev.OWNER.com

# Images built by CI
API_IMAGE=ghcr.io/vik-koch/b2b-catalog-platform-api:0.1.0
WEB_IMAGE=ghcr.io/vik-koch/b2b-catalog-platform-web:0.1.0

# PostgreSQL — only reachable on the stack-internal Docker network
POSTGRES_DB=b2b_catalog
POSTGRES_USER=b2b_catalog
POSTGRES_PASSWORD=change-me

# Signs the session JWT. Required by the api in server mode; min 32
# chars, unique per stack, kept secret. Generate one: `openssl rand -base64 48`.
# Keep it STABLE across deploys — changing it invalidates every open session
# (which is also the emergency "log everyone out" lever).
# In CI-driven deploys this comes from a GitHub secret, not this file.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Bootstrap admin — required by the bootstrap-admin one-shot, which runs on every
# deploy and creates this account only if it does not exist yet. The admin logs
# in and changes the password in-app afterwards, so this is a first-boot value:
# once the account exists, editing it here changes nothing (create-if-missing
# never clobbers a rotated password). Min 8 chars.
# In CI-driven deploys these come from GitHub secrets, not this file.
ADMIN_EMAIL=admin@change-me.example
ADMIN_PASSWORD=change-me-first-login-password

# No value in this file may contain a '$' — Compose reads it for interpolation
# and would treat '$' as a variable reference. openssl-generated values are safe;
# a hand-picked ADMIN_PASSWORD is the one to watch.

# Mail. Required by the api in server mode.
# - Non-prod (dev/demo): deploy with the compose.mailpit.yml overlay and point
#   these at its sink — MAIL_HOST=mailpit, MAIL_PORT=1025, no MAIL_USER/PASSWORD.
# - Prod: a real provider's host/port/credentials; MAIL_SECURE=true for
#   implicit TLS (port 465), MAIL_USER/MAIL_PASSWORD as the provider requires.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=Coffee Kontor <no-reply@coffee-kontor.example>
MAIL_CONTACT_TO=hallo@coffee-kontor.example
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_SECURE=false

# Whether crawlers may index this stack. Drives# robots.txt, sitemap.xml,
# and a noindex meta tag. Defaults to false in compose, so it is only worth
# setting on a real client prod, where it must be true.
# Dev and the portfolio demo/public-prod stay false. Pre-launch, maintenance
# mode keeps crawlers out regardless, so true is safe from a client prod's first boot.
SEO_INDEXABLE=true

# --- Per-deployment config ---
# Absolute container paths for the ./config mount (see compose.yml). The web (SSR)
# and API load their branding/text/wording whole from these files; there is no
# baked default, so an unset var or a missing file fails the boot. compose already
# defaults these to the same /config/... paths, so on the VM they are optional —
# kept explicit here for clarity and to match .env.localtest.
DEPLOYMENT_CONFIG_FILE=/config/deployment.json
APP_TEXT_FILE=/config/app-text.json
INQUIRY_TEXT_FILE=/config/inquiry-text.json
CONFIG_ASSETS_DIR=/config/assets

# Reviewer inbox basic-auth (only with the compose.mailpit.yml overlay). An
# htpasswd "user:hashed" entry; generate an SHA1 one (no '$' to trip Compose):
#   printf '%s' 'the-password' | openssl sha1 -binary | openssl base64
#   -> INBOX_BASICAUTH=reviewer:{SHA}<that output>
# INBOX_BASICAUTH=reviewer:{SHA}...

# Scheduled DB backups (NFR-OPS-04). Enabling the 'backup' profile
# starts the db-backup sidecar; long-lived stacks (dev/prod) set this, the
# ephemeral demo leaves it unset so no backups run there. Dumps land in
# ./backups on the VM (=> /srv/b2b/<stack>/backups) — copy them off with:
#   scp -r deploy@<host>:/srv/b2b/<stack>/backups .
COMPOSE_PROFILES=backup
# Cron expression or a preset like @daily / @hourly; rotation defaults below.
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_WEEKS=8
# BACKUP_KEEP_MONTHS=6

# Orphan media prune (0021). The API server sweeps uploaded images no stored
# content references, in-process on a timer (no sidecar, no profile). Defaults
# below are baked into the API; override only to tune. On a first prod run set
# MEDIA_PRUNE_DRY_RUN=true and watch the api logs ("MediaPrune") before it deletes.
# MEDIA_PRUNE_INTERVAL_HOURS=24
# MEDIA_PRUNE_GRACE_HOURS=24
# MEDIA_PRUNE_DRY_RUN=false

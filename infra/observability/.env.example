# Template for the observability stack's .env (lives next to compose.yml on the
# VM). Only long-lived VMs (dev/prod) run this stack.

# Ops hostname for Grafana. Needs its own DNS record (A -> this VM, DNS-only)
# and a Let's Encrypt cert issues on first hit.
GRAFANA_DOMAIN=logs.example.com

# Grafana's built-in `admin` password. Keep stable across deploys.
GRAFANA_ADMIN_PASSWORD=change-me

# --- Alerting ---------------------------------------------------------------
# Grafana mails alerts through the same SMTP account the app sends with; alerts
# are rare, so they do not warrant a separate sender. Alerts cover the three
# things that actually take a VM down: disk filling, backups failing, and a
# spike of server errors.
SMTP_HOST=smtp.example.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
# Only for a local/self-signed relay; leave false against a real provider.
SMTP_SKIP_VERIFY=false

# Who gets the alerts. Comma-separated for several recipients.
ALERT_EMAIL=ops@example.com

        "consentRequired": true
      }
    },
    {
      "name": "Dublin Collection Point",
      "description": "Unit 22, Belgard Trade Park, Dublin 24, D24 R6X5",
      "map": {
        "url": "https://www.openstreetmap.org/export/embed.html?bbox=-6.3705%2C53.2990%2C-6.3575%2C53.3050&layer=mapnik&marker=53.3020%2C-6.3640",
        "consentRequired": true
      }
    }
  ],
  "mapProvider": "OpenStreetMap",
  "pickup": {
    "locations": [
      {
        "key": "enniscorthy",
        "name": "Enniscorthy Trade Counter",
        "address": "Unit 7, Slaneyside Business Park, Enniscorthy, Y21 W8K4",
        "description": "Weekdays 8:30–17:00, at the trade counter beside goods in.",
        "mapUrl": "https://www.openstreetmap.org/?mlat=52.4985&mlon=-6.5660#map=17/52.4985/-6.5660"
      },
      {
        "key": "dublin",
        "name": "Dublin Collection Point",
        "address": "Unit 22, Belgard Trade Park, Dublin 24, D24 R6X5",
        "description": "Tuesdays and Thursdays 9:00–13:00; orders placed by noon the day before.",
        "mapUrl": "https://www.openstreetmap.org/?mlat=53.3020&mlon=-6.3640#map=17/53.3020/-6.3640"
      }
    ]
  },
  "contact": {
    "phone": "+353 53 923 4000",
    "email": "sales@slaney-labware.example"
  },
  "notice": {
    "text": "Slaney Labware is a demonstration shop.",
    "link": {
      "label": "About this demo",
      "url": "https://github.com/vik-koch/b2b-catalog-platform"
    }
  },
  "phoneInput": {
    "countryCode": "+353"
  },
  "orderReference": {
    "prefix": "SL",
    "timezone": "Europe/Dublin"
  },
  "delivery": {
    "zones": [
      {
        "key": "south-east",
        "title": "South-east",
        "description": "Delivered by our own van, usually the next working day.",
        "freeFromMinor": 15000,
        "match": {
          "postalPrefixes": [
            "Y21",
            "Y25",
            "Y34",
            "Y35",
            "R93",
            "R95",
            "X91",
            "R21"
          ]
        }
      },
      {
        "key": "rest",
        "title": "Rest of Ireland",
        "description": "By courier, one to two working days.",
        "freeFromMinor": 30000,
        "match": {
          "all": true
        }
      }
    ]
  },
  "address": {
    "countries": [
      {
        "code": "IE",
        "label": "Ireland",
        "postalCode": {
          "pattern": "^(?:[AC-FHKNPRTV-Y][0-9]{2}|D6W)[0-9AC-FHKNPRTV-Y]{4}$",
          "example": "Y21 F4E2"
        }
      }
    ]
  },
  "companyIdInput": {
    "formats": [
      {
        "key": "vat",
        "label": "VAT number",
        "pattern": "^IE(?:[0-9]{7}[A-W][A-IW]?|[0-9][A-Z+*][0-9]{5}[A-W])$",
        "example": "IE1234567T"
      },
      {
        "key": "cro",
        "label": "Company number",
        "pattern": "^[0-9]{5,6}$",
        "example": "123456"
      }
    ]
  },
  "customerTypes": ["company"]
}

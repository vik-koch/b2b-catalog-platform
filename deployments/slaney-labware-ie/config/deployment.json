      "muted": "#475569",
      "subtle": "#5d6c83",
      "edge": "#e2e8f0",
      "edgeStrong": "#cbd5e1",
      "neutrals": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "125": "#ebf0f5",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",

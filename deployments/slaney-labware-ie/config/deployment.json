        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#020617"
      }
    },
    "font": {
      "family": "'IBM Plex Sans', system-ui, sans-serif",
      "stylesheet": "fonts/fonts.css",
      "emphasisWeight": 600,
      "pdf": {
        "regular": "fonts/IBMPlexSans-Regular.ttf",
        "bold": "fonts/IBMPlexSans-Bold.ttf"
      }
    }
  },
  "pages": {
    "published": [
      "about",
      "contact",
      "conditions",
      "terms",
      "privacy",
      "imprint"
    ],
    "headerNav": ["conditions", "contact"],
    "footerNav": ["about", "terms", "privacy", "imprint", "licenses"]
  },
  "consent": {
    "contact": false,
    "account": false
  },
  "seller": {
    "name": "Slaney Labware Ltd",
    "registration": ["Company number 000000", "VAT IE0000000X"]
  },
  "tax": {
    "basis": "added",
    "rate": 23,
    "statedAtPrices": true
  },
  "cookieConsentEnabled": true,
  "billingAddressEnabled": true,
  "catalog": {
    "currency": {
      "code": "EUR"
    },
    "boxUnits": {
      "volume": "m³",
      "weight": "kg"
    },
    "lowStockThresholdPieces": 10,
    "pairingsEnforced": false,
    "sortControlsEnabled": true
  },
  "search": {},
  "locations": [
    {
      "name": "Enniscorthy Warehouse & Trade Counter",
      "description": "Unit 7, Slaneyside Business Park, Enniscorthy, Co. Wexford, Y21 W8K4",
